# Windows 11-style taskbar for the UBos Linux desktop (Fluxbox + tint2).
# Lives in the repo at remote-runner/taskbar/tint2rc; win11-taskbar.sh installs
# it to ~/.config/tint2/tint2rc (replacing __TASKBAR_DIR__ with the real path)
# and starts tint2 on the desktop display. The repo copy is the source of
# truth -- rebuilds wipe ~/.config, so do not edit the installed copy by hand.

#-------------------------------------
# Backgrounds (ids are assigned in file order, starting at 0)
# Background 0: transparent
rounded = 0
border_width = 0
border_sides = TBLR
background_color = #000000 0
border_color = #000000 0

# Background 1: taskbar panel (dark Windows 11)
rounded = 8
border_width = 1
border_sides = TBLR
background_color = #202020 88
border_color = #3a3a3a 100
background_color_hover = #2b2b2b 88
border_color_hover = #4a4a4a 100

# Background 2: inactive task button
rounded = 4
border_width = 0
border_sides = TBLR
background_color = #000000 0
border_color = #000000 0
background_color_hover = #333333 80
border_color_hover = #000000 0

# Background 3: active (focused) task -- underlined with the accent colour
rounded = 4
border_width = 3
border_sides = B
background_color = #2d2d2d 100
border_color = #4cc2ff 100
background_color_hover = #3a3a3a 100
border_color_hover = #4cc2ff 100

# Background 4: urgent task (needs attention)
rounded = 4
border_width = 3
border_sides = B
background_color = #7a2e2e 100
border_color = #ff6464 100

# Background 5: tooltip
rounded = 4
border_width = 1
border_sides = TBLR
background_color = #222222 100
border_color = #555555 100

# Background 6: Start button
rounded = 6
border_width = 0
border_sides = TBLR
background_color = #000000 0
border_color = #000000 0
background_color_hover = #3a3a3a 90
border_color_hover = #000000 0
background_color_pressed = #4a4a4a 100
border_color_pressed = #000000 0

#-------------------------------------
# Panel: centered bottom pill
panel_items = PTSC
panel_size = 100% 52
panel_margin = 0 8
panel_padding = 4 2 4
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 1
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0.5
autohide_height = 2
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 1
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0

#-------------------------------------
# Start button (button plugin; opens the Start menu)
button = new
button_icon = __TASKBAR_DIR__/win11-logo.png
button_tooltip = Start
button_font = sans 10
button_font_color = #ffffff 100
button_background_id = 6
button_centered = 1
button_padding = 6 4 0
button_max_icon_size = 26
button_lclick_command = __TASKBAR_DIR__/start-menu.sh
button_rclick_command = fluxbox-remote RootMenu

#-------------------------------------
# Taskbar: one taskbar, current desktop; icon-only buttons
taskbar_mode = single_desktop
taskbar_hide_if_empty = 1
taskbar_padding = 4 2 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0

# Taskbar buttons
task_text = 0
task_icon = 1
task_centered = 1
task_maximum_size = 48 48
task_padding = 4 6 4
task_font = sans 10
task_font_color = #ffffff 100
task_active_font_color = #ffffff 100
task_urgent_font_color = #ffffff 100
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 2

#-------------------------------------
# System tray (notification area)
systray_padding = 6 4 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = 1

#-------------------------------------
# Clock: time on top, date underneath
time1_format = %-I:%M %p
time2_format = %a %m/%d/%Y
time1_timezone =
time2_timezone =
clock_font_color = #ffffff 100
clock_padding = 6 2
clock_background_id = 0
clock_tooltip = %A, %B %d %Y
clock_tooltip_timezone =
clock_lclick_command =
clock_rclick_command =
clock_mclick_command =
clock_uwheel_command =
clock_dwheel_command =

#-------------------------------------
# Tooltip
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 4 4
tooltip_background_id = 5
tooltip_font_color = #dddddd 100

#-------------------------------------
# Battery (hidden on a desktop)
battery_hide = 101
battery_tooltip = 0
battery_low_status = 10
battery_low_cmd =
battery_full_cmd =
